{
  "name": "url-shortener",
  "version": "0.0.0",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "start": "node ./dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon",
    "test": "jest --watchAll --no-cache --detectOpenHandles",
    "test:unit": "jest --testPathPattern=src --runInBand --passWithNoTests",
    "lint": "npx eslint . --ext .js,.ts,.cjs,.mjs",
    "lint:fix": "eslint . --ext .js,.ts,.cjs,.mjs --fix",
    "prepare": "husky install",
    "docker:logs": "docker-compose logs -f app",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose stop",
    "docker:rm": "docker-compose rm -sf",
    "docker:clean": "docker-compose down --volumes --rmi all"
  },
  "author": "Gabriel Martins",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jest": "^28.12.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.2.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3"
  }
}
